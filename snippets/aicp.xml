<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="aicp"
           fetch="https://git@github.com/"
           review="gerrit.aicp-rom.com"
           revision="refs/heads/x17.0"
           sync-c="true"
           sync-j="8" />

  <remote  name="omni"
           fetch="https://git@github.com/"
           review="gerrit.omnirom.org"
           revision="refs/heads/android-17"
           sync-c="true"
           sync-j="8" />

  <remote  name="github_native"
           fetch="https://git@github.com/"
           sync-c="true"
           sync-j="8" />

  <remote  name="gitlab"
           fetch="https://gitlab.com/"
           revision="refs/heads/x17.0"
           sync-c="true"
           sync-j="8" />

  <!-- Remove needed AOSP and Lineage Repos that we have a fork of -->
  <include name="snippets/remove.xml" />

  <!-- Remove Lineage repos that we don't have a fork of and don't need -->
  <include name="snippets/ignore.xml" />

  <!-- weirddroid1 non-platform -->
  <project path="device/aicp/sepolicy" name="weirddroid1/device_aicp_sepolicy" remote="aicp" />
  <project path="frameworks/opt/aicpgear" name="weirddroid1/frameworks_opt_aicpgear" remote="aicp" />
  <project path="frameworks/opt/slimrecent" name="weirddroid1/frameworks_opt_slimrecent" remote="aicp" />
  <project path="lineage/mirror" name="weirddroid1/mirror" groups="infra" revision="main" remote="aicp" />
  <project path="lineage/scripts" name="weirddroid1/scripts" groups="tools" remote="aicp" revision="main" />
  <project path="packages/apps/AicpExtras" name="weirddroid1/packages_apps_AicpExtras" remote="aicp" />
  <project path="packages/apps/GameSpace" name="weirddroid1/packages_apps_GameSpace" remote="aicp" />
  <project path="packages/apps/LineageParts" name="weirddroid1/packages_apps_LineageParts" remote="aicp" />
  <project path="packages/apps/SetupWizard" name="weirddroid1/packages_apps_SetupWizard" remote="aicp" />
  <project path="packages/apps/TilesWallpaper" name="weirddroid1/packages_apps_TilesWallpaper" remote="aicp" />
  <project path="packages/apps/Updater" name="weirddroid1/packages_apps_Updater" remote="aicp" />
  <project path="packages/overlays/aicp" name="weirddroid1/packages_overlays_aicp" remote="aicp" />
  <project path="packages/overlays/Lineage" name="weirddroid1/packages_overlays_Lineage" remote="aicp" />
  <project path="packages/resources/deviceparts" name="weirddroid1/packages_resources_deviceparts" remote="aicp" />
  <project path="packages/resources/devicesettings" name="weirddroid1/packages_resources_devicesettings" remote="aicp" />
  <project path="packages/services/OmniJaws" name="weirddroid1/packages_services_OmniJaws" remote="aicp" />
  <project path="prebuilts/tools-aicp" name="LineageOS/android_prebuilts_tools-lineage" clone-depth="1" />
  <project path="vendor/aicp" name="weirddroid1/vendor_aicp" remote="aicp" />

  <!-- weirddroid1 platform -->
  <project path="build/make" name="weirddroid1/build" groups="pdk,sysui-studio" remote="aicp" >
    <linkfile dest="build/CleanSpec.mk" src="CleanSpec.mk" />
    <linkfile dest="build/buildspec.mk.default" src="buildspec.mk.default" />
    <linkfile dest="build/core" src="core" />
    <linkfile dest="build/envsetup.sh" src="envsetup.sh" />
    <linkfile dest="build/target" src="target" />
    <linkfile dest="build/tools" src="tools" />
  </project>
  <project path="build/soong" name="weirddroid1/build_soong" groups="pdk,tradefed" remote="aicp" >
    <linkfile dest="Android.bp" src="root.bp" />
    <linkfile dest="bootstrap.bash" src="bootstrap.bash" />
  </project>
  <project path="frameworks/av" name="weirddroid1/frameworks_av" remote="aicp" />
  <project path="frameworks/base" name="weirddroid1/frameworks_base" remote="aicp" />
  <project path="packages/apps/Dialer" name="weirddroid1/packages_apps_Dialer" remote="aicp" />
  <project path="packages/apps/Launcher3" name="weirddroid1/packages_apps_Launcher3" remote="aicp" />
  <project path="packages/apps/Settings" name="weirddroid1/packages_apps_Settings" groups="pdk-fs" remote="aicp" />
  <project path="packages/apps/ThemePicker" name="weirddroid1/packages_apps_ThemePicker" remote="aicp" />
  <project path="packages/modules/DnsResolver" name="weirddroid1/packages_modules_DnsResolver" groups="pdk-cw-fs,pdk-fs" remote="aicp" />
  <project path="platform_manifest" name="weirddroid1/platform_manifest" remote="aicp" />
  <project path="system/core" name="weirddroid1/system_core" groups="pdk" remote="aicp" />

  <!-- Other additions -->
  <project path="external/colorkt" name="ProtonAOSP/android_external_colorkt" remote="github" revision="sc-qpr3" />
  <project path="external/hosts" name="StevenBlack/hosts" remote="github" revision="master" clone-depth="10" />
  <project path="external/themelib" name="ProtonAOSP/android_external_themelib" remote="github" revision="sc-qpr3" />
  <project path="vendor/lawnicons" name="ProtonAOSP/android_vendor_lawnicons" remote="github" revision="sc-qpr3" />

</manifest>
